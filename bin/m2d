#!/usr/bin/env bash
# shellcheck shell=bash

function _m2d_display_help_main ()
{
    echo "
Usage: ./bin/m2d COMMAND [OPTIONS]

Examples:
- initial setup:
./bin/m2d setup init

- build and start containers:
./bin/m2d up --build

- stop and remove containers and networks:
./bin/m2d down


Options:
  -h, --help Display help for command

Commands:
  build    Build or rebuild containers
  clean    Find and optionally remove installed projects older than M2D_STALE_PROJECT_DAYS days
  disable  Disable selected service or tool
  down     Stop and remove containers and networks
  enable   Enable selected service or tool
  go       Enters a running container
  logs     View logs from containers
  set      Sets configuration value
  setup    Configure project
  show     Shows configuration value
  stop     Stops containers
  sync     Manage data sync from between host and containers
  up       Create and start containers
  run-magento  Execute a command inside the web container as the magento user
  urls         List all host-accessible URLs and service endpoints
"
}

function _m2d_display_help_run_magento ()
{
    echo "
Usage: ./bin/m2d run-magento [-C <project>] [--] [command [args...]]

Execute a command inside the web container as the magento user.
If no command is given, an interactive bash shell is opened.

Options:
  -C, --dir <project>   Change to /var/www/html/<project> before running
  -h, --help            Display this help

Examples:
  ./bin/m2d run-magento
  ./bin/m2d run-magento -C myproject
  ./bin/m2d run-magento -C myproject bin/magento cache:flush
  ./bin/m2d run-magento -C myproject bin/magento indexer:reindex
  ./bin/m2d run-magento composer install
  ./bin/m2d run-magento yarn install
"
}

function _m2d_run_magento ()
{
    local env_file="$1"
    shift
    local suffix
    suffix=$(_m2d_env_get_parameter "$env_file" M2D_PROJECT_SUFFIX)
    local container="m2d-web${suffix}"
    local workdir="/var/www/html"

    # Parse options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -C|--dir)
                workdir="/var/www/html/${2}"
                shift 2
                ;;
            -h|--help)
                _m2d_display_help_run_magento
                return 0
                ;;
            --)
                shift
                break
                ;;
            *)
                break
                ;;
        esac
    done

    # Check the container is running
    if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${container}$"; then
        echo "Container '${container}' is not running. Start it with: ./bin/m2d up"
        return 1
    fi

    # Attach a TTY only when stdin is a terminal
    local tty_flag=""
    [[ -t 0 ]] && tty_flag="-t"

    if [[ $# -eq 0 ]]; then
        # Interactive shell — pass terminal dimensions when available
        local extra_env=()
        local cols lines
        cols=$(tput cols 2>/dev/null)   && extra_env+=(--env "COLUMNS=${cols}")
        lines=$(tput lines 2>/dev/null) && extra_env+=(--env "LINES=${lines}")
        docker exec -i ${tty_flag} \
            "${extra_env[@]}" \
            --user magento \
            --workdir "$workdir" \
            "$container" bash
    else
        docker exec -i ${tty_flag} \
            --user magento \
            --workdir "$workdir" \
            "$container" "$@"
    fi
}

function _m2d_urls ()
{
    local env_file="$1"
    local suffix
    suffix=$(_m2d_env_get_parameter "$env_file" M2D_PROJECT_SUFFIX)

    # ── helpers ────────────────────────────────────────────────────────────────
    local BOLD=$'\033[1m' DIM=$'\033[2m' RESET=$'\033[0m' CYAN=$'\033[36m' GREEN=$'\033[32m' YELLOW=$'\033[33m'
    _p() { printf "  %-18s  %s\n" "$1" "$2"; }
    _h() { echo ""; printf "${BOLD}${CYAN}%s${RESET}\n" "$1"; printf '%0.s─' {1..60}; echo ""; }

    # ── read .env values ───────────────────────────────────────────────────────
    local http_port https_port ssh_port
    http_port=$(_m2d_env_get_parameter "$env_file" M2D_PORT_FOR_WEB_SERVER_HTTP   80)
    https_port=$(_m2d_env_get_parameter "$env_file" M2D_PORT_FOR_WEB_SERVER_HTTPS 443)
    ssh_port=$(_m2d_env_get_parameter   "$env_file" M2D_PORT_FOR_WEB_SERVER_SSH   2222)

    local db_port db_slave_port db_monitor_port db_vendor db_version db_repl_enabled
    db_port=$(_m2d_env_get_parameter       "$env_file" M2D_PORT_FOR_DB_ENGINE       3306)
    db_slave_port=$(_m2d_env_get_parameter "$env_file" M2D_PORT_FOR_DB_SLAVE_ENGINE 3307)
    db_monitor_port=$(_m2d_env_get_parameter "$env_file" M2D_PORT_FOR_DB_MONITOR    8099)
    db_vendor=$(_m2d_env_get_parameter     "$env_file" M2D_DB_ENGINE_VENDOR         mariadb)
    db_version=$(_m2d_env_get_parameter    "$env_file" M2D_DB_ENGINE_VERSION        10)
    db_repl_enabled=$(_m2d_env_get_parameter "$env_file" M2D_ENABLE_DB_REPLICATION  no)

    local es7_port es7_version es7_enabled es8_port es8_version es8_enabled
    local os_port os_version os_enabled
    es7_port=$(_m2d_env_get_parameter    "$env_file" M2D_PORT_FOR_ES7 9207)
    es7_version=$(_m2d_env_get_parameter "$env_file" M2D_ES7_VERSION  7)
    es7_enabled=$(_m2d_env_get_parameter "$env_file" M2D_ENABLE_ES7   yes)
    es8_port=$(_m2d_env_get_parameter    "$env_file" M2D_PORT_FOR_ES8 9208)
    es8_version=$(_m2d_env_get_parameter "$env_file" M2D_ES8_VERSION  8)
    es8_enabled=$(_m2d_env_get_parameter "$env_file" M2D_ENABLE_ES8   no)
    os_port=$(_m2d_env_get_parameter     "$env_file" M2D_PORT_FOR_OPENSEARCH 9200)
    os_version=$(_m2d_env_get_parameter  "$env_file" M2D_OPENSEARCH_VERSION  2)
    os_enabled=$(_m2d_env_get_parameter  "$env_file" M2D_ENABLE_OPENSEARCH   no)

    local broker_port broker_amqp_port broker_vendor broker_version broker_enabled
    broker_port=$(_m2d_env_get_parameter      "$env_file" M2D_PORT_FOR_MESSAGE_BROKER      15672)
    broker_amqp_port=$(_m2d_env_get_parameter "$env_file" M2D_PORT_FOR_MESSAGE_BROKER_AMQP 5672)
    broker_vendor=$(_m2d_env_get_parameter    "$env_file" M2D_MESSAGE_BROKER_VENDOR         rabbitmq)
    broker_version=$(_m2d_env_get_parameter   "$env_file" M2D_MESSAGE_BROKER_VERSION        3.13)
    broker_enabled=$(_m2d_env_get_parameter   "$env_file" M2D_ENABLE_MESSAGE_BROKER         no)

    local vcache_port vcache_vendor vcache_version vcache_enabled
    vcache_port=$(_m2d_env_get_parameter    "$env_file" M2D_PORT_FOR_WEB_CACHE    8080)
    vcache_vendor=$(_m2d_env_get_parameter  "$env_file" M2D_WEB_CACHE_VENDOR      varnish)
    vcache_version=$(_m2d_env_get_parameter "$env_file" M2D_WEB_CACHE_VERSION     6)
    vcache_enabled=$(_m2d_env_get_parameter "$env_file" M2D_ENABLE_WEB_CACHE      no)

    local redis_port redis_vendor redis_version redis_enabled
    redis_port=$(_m2d_env_get_parameter    "$env_file" M2D_PORT_FOR_DB_CACHE    6379)
    redis_vendor=$(_m2d_env_get_parameter  "$env_file" M2D_DB_CACHE_VENDOR      redis)
    redis_version=$(_m2d_env_get_parameter "$env_file" M2D_DB_CACHE_VERSION     6.2)
    redis_enabled=$(_m2d_env_get_parameter "$env_file" M2D_ENABLE_DB_CACHE      no)

    local mail_port mail_enabled
    mail_port=$(_m2d_env_get_parameter    "$env_file" M2D_PORT_FOR_MAILCATCHER 1080)
    mail_enabled=$(_m2d_env_get_parameter "$env_file" M2D_ENABLE_MAILCATCHER   no)

    # ── disabled label helper ──────────────────────────────────────────────────
    _flag() { [[ "$1" == "yes" ]] && echo "" || echo "  ${DIM}(disabled)${RESET}"; }

    # ── SERVICES section ───────────────────────────────────────────────────────
    _h "Services"

    _p "web"        "https://localhost:${https_port}   http://localhost:${http_port}"
    _p "ssh"        "ssh magento@localhost -p ${ssh_port}"
    _p "database"   "mysql://localhost:${db_port}   ${DIM}db:magento  user:magento  pass:magento  [${db_vendor} ${db_version}]${RESET}"

    local dr_flag; dr_flag=$(_flag "$db_repl_enabled")
    _p "db replica" "mysql://localhost:${db_slave_port}${dr_flag}"
    _p "db monitor" "http://localhost:${db_monitor_port}${dr_flag}"

    local es7_flag; es7_flag=$(_flag "$es7_enabled")
    _p "search es7" "http://localhost:${es7_port}   ${DIM}[elasticsearch ${es7_version}]${RESET}${es7_flag}"
    local es8_flag; es8_flag=$(_flag "$es8_enabled")
    _p "search es8" "http://localhost:${es8_port}   ${DIM}[elasticsearch ${es8_version}]${RESET}${es8_flag}"
    local os_flag; os_flag=$(_flag "$os_enabled")
    _p "opensearch" "http://localhost:${os_port}   ${DIM}[opensearch ${os_version}]${RESET}${os_flag}"

    local r_flag; r_flag=$(_flag "$redis_enabled")
    _p "db cache"   "redis://localhost:${redis_port}   ${DIM}[${redis_vendor} ${redis_version}]${RESET}${r_flag}"

    local v_flag; v_flag=$(_flag "$vcache_enabled")
    _p "web cache"  "http://localhost:${vcache_port}   ${DIM}[${vcache_vendor} ${vcache_version}]${RESET}${v_flag}"

    local b_flag; b_flag=$(_flag "$broker_enabled")
    local b_scheme="amqp"; [[ "$broker_vendor" == "activemq" ]] && b_scheme="stomp"
    _p "msg broker" "http://localhost:${broker_port}   ${b_scheme}://localhost:${broker_amqp_port}   ${DIM}[${broker_vendor} ${broker_version}]${RESET}${b_flag}"

    local m_flag; m_flag=$(_flag "$mail_enabled")
    _p "mailcatcher" "http://localhost:${mail_port}   ${DIM}SMTP within Docker: mailcatcher:1025${RESET}${m_flag}"

    # ── PROJECTS section ───────────────────────────────────────────────────────
    _h "Magento Projects"

    local web_container="m2d-web${suffix}"
    if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${web_container}$"; then
        echo "  ${YELLOW}web container not running${RESET} — start with: ./bin/m2d up"
        echo ""
        return
    fi

    # Run discovery script inside the container.
    # Outputs one line per project:  name:php_seg:upward(0|1):dev_port(or empty)
    local raw
    raw=$(docker exec -i "$web_container" bash << 'DISCOVERY'
APACHE_ROOT="${M2D_APACHE_ROOT_DIRECTORY:-/var/www/html}"
DEFAULT_PHP="${M2D_WEB_SERVER_PHP_VERSION:-8.3}"
DEFAULT_SEG="php$(echo "$DEFAULT_PHP" | tr -d '.')"

for project_dir in "$APACHE_ROOT"/*/; do
    [[ -d "$project_dir" ]] || continue
    project=$(basename "$project_dir")
    [[ -f "${project_dir}bin/magento" ]] || continue

    # Detect PHP segment from meta.json
    php_seg="$DEFAULT_SEG"
    if [[ -f "${project_dir}meta.json" ]]; then
        php_bin=$(python3 -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    print(d.get('php',''))
except Exception:
    pass
" "${project_dir}meta.json" 2>/dev/null || true)
        if [[ -n "$php_bin" && -x "$php_bin" ]]; then
            seg=$("$php_bin" -r 'echo "php".PHP_MAJOR_VERSION.PHP_MINOR_VERSION;' 2>/dev/null) \
                && php_seg="$seg" || true
        fi
    fi

    # UPWARD-PHP active?
    upward=0
    grep -q "^SetEnv MAGENTO_BACKEND_URL " "${project_dir}.htaccess" 2>/dev/null && upward=1 || true

    # PWA dev server running?
    dev_port=""
    pid_file="/var/run/pwa/${project}.pid"
    if [[ -f "$pid_file" ]]; then
        pid=$(cat "$pid_file")
        if kill -0 "$pid" 2>/dev/null; then
            dev_port=$(grep "^PWA_PORT=" "${APACHE_ROOT}/${project}/.pwa" 2>/dev/null | cut -d= -f2- || true)
            dev_port="${dev_port:-?}"
        fi
    fi

    echo "${project}:${php_seg}:${upward}:${dev_port}"
done
DISCOVERY
    )

    if [[ -z "$raw" ]]; then
        echo "  ${DIM}No Magento projects found in the web root.${RESET}"
        echo "  ${DIM}Install a project first: m2install${RESET}"
        echo ""
        return
    fi

    local first=1
    while IFS=: read -r name php_seg upward dev_port; do
        [[ $first -eq 1 ]] && first=0 || echo ""
        printf "  ${BOLD}%-16s${RESET}  ${DIM}%s${RESET}\n" "$name" "$php_seg"

        if [[ "$upward" == "1" ]]; then
            # UPWARD-PHP: same URL as Magento, but served as PWA
            printf "  %-18s  https://%s.%s.127.0.0.1.nip.io/  ${DIM}[PWA via UPWARD-PHP]${RESET}\n" "" "$name" "$php_seg"
        else
            printf "  %-18s  https://%s.%s.127.0.0.1.nip.io/\n" "" "$name" "$php_seg"
        fi

        if [[ -n "$dev_port" ]]; then
            local port_label=""
            [[ "$dev_port" != "?" ]] && port_label="  ${DIM}[:${dev_port}]${RESET}"
            printf "  %-18s  https://pwa-%s.%s.127.0.0.1.nip.io/${GREEN}  ▶ dev server running${RESET}%s\n" "" "$name" "$php_seg" "$port_label"
        fi
    done <<< "$raw"
    echo ""
}

function _m2d_display_help_clean ()
{
    echo "
Usage: ./bin/m2d clean [OPTIONS]

Find installed Magento projects older than \$M2D_STALE_PROJECT_DAYS days (default 30) and
offer to remove them, one at a time. Never deletes without an explicit 'y' per project, and
never touches the shared database — only the project folder and its PWA dev-server state.

Options:
  -h, --help   Display help for command
  --dry-run    List stale projects without prompting or changing anything.
"
}

function _m2d_confirm ()
{
    local prompt="$1" confirm
    printf '%s' "$prompt" >&2; read confirm
    [[ $confirm == 'y' ]]
}

function _m2d_clean_discover ()
{
    # Emits one line per installed project, unfiltered by age:
    #   name:age_days:source(marker|mtime):has_running_pwa(0|1)
    # Callers decide the staleness threshold. Returns non-zero if the web container isn't up.
    local env_file="$1"
    local suffix; suffix=$(_m2d_env_get_parameter "$env_file" M2D_PROJECT_SUFFIX)
    local web_container="m2d-web${suffix}"

    docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${web_container}$" || return 1

    docker exec -i "$web_container" bash << 'DISCOVERY'
APACHE_ROOT="${M2D_APACHE_ROOT_DIRECTORY:-/var/www/html}"
now=$(date -u +%s)

for project_dir in "$APACHE_ROOT"/*/; do
    [[ -d "$project_dir" ]] || continue
    project=$(basename "$project_dir")
    [[ -f "${project_dir}bin/magento" ]] || continue

    # Precise where the multi-variant m2install.sh wrapper stamped it; otherwise fall back to
    # the project folder's own mtime (labeled so callers can show it's approximate).
    installed_epoch=""
    source_label="mtime"
    installed_at=$(grep "^M2D_INSTALLED_AT=" "${project_dir}.m2install.conf" 2>/dev/null | cut -d= -f2-)
    if [[ -n "$installed_at" ]]; then
        installed_epoch=$(date -u -d "$installed_at" +%s 2>/dev/null || echo "")
        [[ -n "$installed_epoch" ]] && source_label="marker"
    fi
    if [[ -z "$installed_epoch" ]]; then
        installed_epoch=$(stat -c %Y "$project_dir" 2>/dev/null || echo "$now")
    fi
    age_days=$(( (now - installed_epoch) / 86400 ))

    has_pwa=0
    for pidfile in /var/run/pwa/"${project}"*.pid; do
        [[ -f "$pidfile" ]] || continue
        pid=$(cat "$pidfile" 2>/dev/null)
        [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && { has_pwa=1; break; }
    done

    echo "${project}:${age_days}:${source_label}:${has_pwa}"
done
DISCOVERY
}

function _m2d_clean ()
{
    local env_file="$1"
    local dry_run="${2:-0}"
    local threshold; threshold=$(_m2d_env_get_parameter "$env_file" M2D_STALE_PROJECT_DAYS 30)
    local suffix; suffix=$(_m2d_env_get_parameter "$env_file" M2D_PROJECT_SUFFIX)
    local web_container="m2d-web${suffix}"

    local raw
    if ! raw=$(_m2d_clean_discover "$env_file"); then
        echo "web container not running — start with: ./bin/m2d up"
        return 1
    fi

    if [[ -z "$raw" ]]; then
        echo "No Magento projects found."
        return 0
    fi

    local -a stale_names=() stale_ages=() stale_sources=() stale_pwas=()
    while IFS=: read -r name age source_label has_pwa; do
        [[ -z "$name" ]] && continue
        (( age >= threshold )) || continue
        stale_names+=("$name"); stale_ages+=("$age"); stale_sources+=("$source_label"); stale_pwas+=("$has_pwa")
    done <<< "$raw"

    if [[ ${#stale_names[@]} -eq 0 ]]; then
        echo "No installs older than ${threshold} days."
        return 0
    fi

    echo "Installs older than ${threshold} days:"
    local i label pwa_note
    for i in "${!stale_names[@]}"; do
        label="${stale_sources[$i]}"; [[ "$label" == "mtime" ]] && label="mtime, approximate"
        pwa_note=""; [[ "${stale_pwas[$i]}" == "1" ]] && pwa_note="  (has a running PWA dev server)"
        printf "  %-20s  %s days old  (%s)%s\n" "${stale_names[$i]}" "${stale_ages[$i]}" "$label" "$pwa_note"
    done

    [[ "$dry_run" -eq 1 ]] && return 0

    echo ""
    local name age src
    for i in "${!stale_names[@]}"; do
        name="${stale_names[$i]}"; age="${stale_ages[$i]}"; src="${stale_sources[$i]}"
        label="$src"; [[ "$label" == "mtime" ]] && label="mtime, approximate"

        if _m2d_confirm "Remove project '${name}' — installed ~${age} days ago (${label})? [y/n]: "; then
            echo "[clean] Stopping any PWA dev servers for '${name}'..."
            docker exec -i "$web_container" bash -s -- "$name" << 'STOPALL'
APACHE_ROOT="${M2D_APACHE_ROOT_DIRECTORY:-/var/www/html}"
project="$1"
for meta in "${APACHE_ROOT}/${project}"/.pwa.*; do
    [[ -f "$meta" ]] || continue
    base=$(basename "$meta")
    store="${base#.pwa.}"
    pwa-stop "$project" --store "$store" 2>/dev/null || true
done
[[ -f "${APACHE_ROOT}/${project}/.pwa" ]] && { pwa-stop "$project" 2>/dev/null || true; }
STOPALL

            echo "[clean] Removing project folder (the shared database is never touched)..."
            docker exec -i "$web_container" bash -s -- "$name" << 'REMOVE'
APACHE_ROOT="${M2D_APACHE_ROOT_DIRECTORY:-/var/www/html}"
project="$1"
rm -rf "${APACHE_ROOT:?}/${project:?}"
REMOVE
            echo "[clean] Removed '${name}'."
        else
            echo "[clean] Skipped '${name}'."
        fi
    done
}

function _m2d_clean_nudge ()
{
    # One-line, non-blocking notice — never prompts. Full review is `bin/m2d clean`.
    local env_file="$1"
    local threshold; threshold=$(_m2d_env_get_parameter "$env_file" M2D_STALE_PROJECT_DAYS 30)

    local raw
    raw=$(_m2d_clean_discover "$env_file") || return 0
    [[ -z "$raw" ]] && return 0

    local count=0 age
    while IFS=: read -r _ age _ _; do
        [[ -z "$age" ]] && continue
        (( age >= threshold )) && count=$((count + 1))
    done <<< "$raw"

    (( count > 0 )) && echo "Note: ${count} install(s) are older than ${threshold} days. Run \`./bin/m2d clean\` to review."
}

function _m2d_display_help_set ()
{
    echo "
Usage: ./bin/m2d set [OPTIONS] PARAMETER VALUE

Sets configuration value.

Examples:
./bin/m2d set M2D_XDEBUG_IDE_KEY VSCODE
./bin/m2d set es 8.4
./bin/m2d set activemq

Options:
  -h, --help Display help for command

Parameters:
  es       Alias for setting Elasticsearch as the search engine. It will set M2D_SEARCH_ENGINE_VENDOR to 'elasticsearch',
           and M2D_SEARCH_ENGINE_VERSION to '7' if the expected version is not provided as a value
  activemq Alias for using ActiveMQ (Artemis) as the message broker. Sets M2D_MESSAGE_BROKER_VENDOR to 'activemq',
           M2D_MESSAGE_BROKER_VERSION to '2.42' (unless provided), and the broker ports to 8161/61616
  rabbit   Alias for using RabbitMQ as the message broker. Sets M2D_MESSAGE_BROKER_VENDOR to 'rabbitmq',
           M2D_MESSAGE_BROKER_VERSION to '3.13' (unless provided), and the broker ports to 15672/5672
  php      Alias for parameter M2D_WEB_SERVER_PHP_VERSION
  suffix   Alias for parameter M2D_PROJECT_SUFFIX
  [M2D_*]  Parameter name. A list of possible parameters and their values is in the '.env.example' file
"
}

function _m2d_display_help_show ()
{
    echo "
Usage: ./bin/m2d show [OPTIONS] PARAMETER

Shows configuration value.

Example:
./bin/m2d show M2D_SOURCE_DIRECTORY

Options:
  -h, --help Display help for command

Parameters:
  home     Display path to the directory where Magento2Docker is installed
  src      Display path to the source directory [M2D_SOURCE_DIRECTORY]
  [M2D_*]  Parameter name. A list of possible parameters is in the '.env.example' file
"
}

