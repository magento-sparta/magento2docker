#!/bin/bash
# pwa-build — build PWA Studio and wire up UPWARD-PHP in Magento
#
# USAGE
#   pwa-build [project] [--php VERSION]
#
# OPTIONS
#   --php VERSION   Override detected PHP version for bin/magento calls, e.g. --php 8.3
#                   Also updates meta.json so future runs use this version.
#                   Useful when upward-connector needs a newer PHP than the project default.
#
# DESCRIPTION
#   1. Ensures magento/module-upward-connector is installed (aborts if missing)
#   2. Enables Magento_UpwardConnector, runs setup:upgrade if needed
#   3. Runs "yarn build" in the PWA project directory
#   4. Sets web/upward/path to the built upward.yml
#   5. Flushes cache
#
#   After pwa-build, the PWA is served through the existing Magento vhost —
#   no pwa-start / Node process required.
#   URL: https://<project>.<phpver>.127.0.0.1.nip.io/
#
# NOTES
#   Run from inside the project dir or pass the project name explicitly.
#   To switch back to Luma: bin/magento config:delete web/upward/path

set -e

source /usr/local/bin/m2d-lib.sh

APACHE_ROOT="${M2D_APACHE_ROOT_DIRECTORY:-/var/www/html}"

# ── Resolve project name and options ─────────────────────────────────────────

usage() {
    sed -n '2,/^set -e/p' "$0" | grep '^#' | sed 's/^# \?//'
    exit "${1:-0}"
}

PROJECT=""
OVERRIDE_PHP=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --php)     OVERRIDE_PHP="$2"; shift 2 ;;
        -h|--help) usage 0 ;;
        -*)        echo "Unknown option: $1"; usage 1 ;;
        *)         PROJECT="$1"; shift ;;
    esac
done

if [[ -z "$PROJECT" ]]; then
    if [[ "$PWD" == "${APACHE_ROOT}/"* ]]; then
        PROJECT=$(echo "$PWD" | sed "s|^${APACHE_ROOT}/||" | cut -d'/' -f1)
        echo "[pwa-build] detected project: $PROJECT"
    else
        echo "Error: project name required (or run from inside the project directory)."
        usage 1
    fi
fi

MAGENTO_ROOT="${APACHE_ROOT}/${PROJECT}"

# ── Load project meta ─────────────────────────────────────────────────────────

META_FILE="${APACHE_ROOT}/${PROJECT}/.pwa"
if [[ ! -f "$META_FILE" ]]; then
    echo "[pwa-build] Error: no .pwa meta file for '${PROJECT}'."
    echo "  Run: pwa-install ${PROJECT}"
    exit 1
fi
PWA_DIR=$(grep "^PWA_DIR=" "$META_FILE" | cut -d= -f2-)

if [[ ! -d "$PWA_DIR" ]]; then
    echo "[pwa-build] Error: PWA directory not found: $PWA_DIR"
    echo "  Run: pwa-install first"
    exit 1
fi

if [[ ! -f "$PWA_DIR/package.json" ]]; then
    echo "[pwa-build] Error: no package.json in $PWA_DIR — run pwa-install first"
    exit 1
fi

if [[ ! -f "$MAGENTO_ROOT/bin/magento" ]]; then
    echo "[pwa-build] Error: bin/magento not found at $MAGENTO_ROOT"
    exit 1
fi

# Detect PHP version for this project (meta.json → .code.tgz → env default)
detect_php "$MAGENTO_ROOT"

# --php override: resolve binary, update meta.json for future runs
if [[ -n "$OVERRIDE_PHP" ]]; then
    _ver="${OVERRIDE_PHP//./}"          # "8.3" → "83", "83" → "83"
    _ver="${_ver#php}"                  # strip leading "php" if present
    _candidate="/usr/local/bin/php${_ver}"
    if [[ ! -x "$_candidate" ]]; then
        echo "[pwa-build] Error: PHP binary not found: $_candidate"
        exit 1
    fi
    PHP_BIN="$_candidate"
    PHP_SEGMENT=$("$PHP_BIN" -r 'echo "php".PHP_MAJOR_VERSION.PHP_MINOR_VERSION;')
    PHP_VERSION=$("$PHP_BIN" -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')
    PHP_DETECTED_FROM="override"
    # Persist to meta.json so future runs inherit this choice
    run_as_magento python3 - "${MAGENTO_ROOT}/meta.json" "$PHP_BIN" <<'PYEOF'
import json, os, sys
path, php_path = sys.argv[1], sys.argv[2]
data = {}
if os.path.isfile(path):
    with open(path) as f:
        try: data = json.load(f)
        except Exception: pass
data['php'] = php_path
with open(path, 'w') as f:
    json.dump(data, f, indent=2)
PYEOF
    echo "[pwa-build] php override: $PHP_BIN — meta.json updated"
fi

# ── Detect install source from .m2install.conf ───────────────────────────────
INSTALL_SOURCE=""
if [[ -f "${MAGENTO_ROOT}/.m2install.conf" ]]; then
    INSTALL_SOURCE=$(grep "^SOURCE=" "${MAGENTO_ROOT}/.m2install.conf" | cut -d= -f2 || true)
fi
# Fallback: filesystem signals (covers projects installed before this wrapper version)
if [[ -z "$INSTALL_SOURCE" ]]; then
    if [[ -d "${MAGENTO_ROOT}/.git" ]]; then
        INSTALL_SOURCE="git"
    elif [[ -f "${MAGENTO_ROOT}/composer.lock" ]]; then
        INSTALL_SOURCE="composer"
    fi
fi

echo "[pwa-build] project    : $PROJECT"
echo "[pwa-build] pwa dir    : $PWA_DIR"
echo "[pwa-build] magento    : $MAGENTO_ROOT"
echo "[pwa-build] php        : $PHP_BIN ($PHP_VERSION) [source: $PHP_DETECTED_FROM]"
echo "[pwa-build] m2 source  : ${INSTALL_SOURCE:-unknown}"

# ── Step 1: verify magento/module-upward-connector is present ─────────────────

echo ""
echo "[pwa-build] ── Step 1: magento/module-upward-connector ─────────────────"
cd "$MAGENTO_ROOT"

# upward-php (Magento\Upward namespace): vendor install or autoload registration
# Adobe Commerce ships it as vendor/magento/upward; open-source installs may use vendor/magento/upward-php
if [[ -d "vendor/magento/upward" ]]; then
    echo "[pwa-build] upward-php: found in vendor (magento/upward)"
elif [[ -d "vendor/magento/upward-php" ]]; then
    echo "[pwa-build] upward-php: found in vendor (magento/upward-php)"
elif grep -q '"Magento\\\\Upward\\\\"' composer.json 2>/dev/null; then
    echo "[pwa-build] upward-php: registered via composer.json autoload"
else
    echo "[pwa-build] Error: magento/upward-php not found."
    if [[ "$INSTALL_SOURCE" == "git" ]]; then
        echo "  Git install — clone and register via autoload:"
        echo "    git clone git@github.com:magento-commerce/upward-php.git .pwa-deps/upward-php"
        echo "    # add to composer.json autoload.psr-4:"
        echo "    #   \"Magento\\\\Upward\\\\\": \".pwa-deps/upward-php/src/\""
        echo "    composer dump-autoload"
    else
        echo "  Composer install — require it:"
        echo "    composer require magento/upward-php"
    fi
    exit 1
fi

# connector: app/code link or vendor install
if [[ -d "app/code/Magento/UpwardConnector" ]]; then
    echo "[pwa-build] connector: found in app/code"
elif [[ -d "vendor/magento/module-upward-connector" ]]; then
    echo "[pwa-build] connector: found in vendor"
else
    echo "[pwa-build] Error: magento/module-upward-connector not found."
    if [[ "$INSTALL_SOURCE" == "git" ]]; then
        echo "  Git install — clone and link into app/code:"
        echo "    git clone git@github.com:magento-commerce/magento2-upward-connector.git .pwa-deps/magento2-upward-connector"
        echo "    mkdir -p app/code/Magento"
        echo "    php dev/tools/build-ee.php --command=link \\"
        echo "        --ee-source=.pwa-deps/magento2-upward-connector \\"
        echo "        --ce-source=app/code/Magento"
    else
        echo "  Composer install — require it:"
        echo "    composer require magento/module-upward-connector"
    fi
    exit 1
fi

# ── Step 2: enable module + setup:upgrade ────────────────────────────────────

echo ""
echo "[pwa-build] ── Step 2: enable module ───────────────────────────────────"
cd "$MAGENTO_ROOT"

if run_as_magento $PHP_BIN bin/magento module:status Magento_UpwardConnector 2>/dev/null | grep -q "Module is enabled"; then
    echo "[pwa-build] Magento_UpwardConnector already enabled"
else
    run_as_magento $PHP_BIN bin/magento module:enable Magento_UpwardConnector --clear-static-content
    run_as_magento $PHP_BIN bin/magento setup:upgrade --no-interaction
fi

# ── Step 3: yarn build ────────────────────────────────────────────────────────

echo ""
echo "[pwa-build] ── Step 3: yarn build ──────────────────────────────────────"
cd "$PWA_DIR"

# @magento/venia-sample-backends is a dev-only extension that validates the
# backend URL by fetching it directly.  Our /pub/ path returns 500, which it
# marks as "inactive" and aborts the build.  The package itself warns it must
# be removed before production builds — do that now if present.
if grep -q '"@magento/venia-sample-backends"' "${PWA_DIR}/package.json" 2>/dev/null; then
    echo "[pwa-build] removing dev-only @magento/venia-sample-backends before production build..."
    run_as_magento yarn remove @magento/venia-sample-backends 2>&1 \
        | grep -v '^warning ' || true
fi

run_as_magento env NODE_TLS_REJECT_UNAUTHORIZED=0 yarn build

UPWARD_YML="${PWA_DIR}/dist/upward.yml"
if [[ ! -f "$UPWARD_YML" ]]; then
    UPWARD_YML=$(find "$PWA_DIR/dist" -name "upward.yml" 2>/dev/null | head -1 || true)
fi
if [[ -z "$UPWARD_YML" || ! -f "$UPWARD_YML" ]]; then
    echo "[pwa-build] Error: dist/upward.yml not found after build"
    exit 1
fi
echo "[pwa-build] upward.yml : $UPWARD_YML"

# ── Step 4: point Magento at the built upward.yml ────────────────────────────

echo ""
echo "[pwa-build] ── Step 4: configure web/upward/path ───────────────────────"
cd "$MAGENTO_ROOT"
run_as_magento $PHP_BIN bin/magento config:set web/upward/path "$UPWARD_YML"
echo "[pwa-build] web/upward/path = $UPWARD_YML"

# ── Step 5: flush cache ───────────────────────────────────────────────────────

echo ""
echo "[pwa-build] ── Step 5: cache:flush ─────────────────────────────────────"
cd "$MAGENTO_ROOT"
run_as_magento $PHP_BIN bin/magento cache:flush

# ── Write MAGENTO_BACKEND_URL to .htaccess ───────────────────────────────────
# Apache passes SetEnv vars to PHP-FPM as FastCGI params; getenv() picks them
# up natively — no prepend.php or FPM pool changes needed.

BACKEND_URL_RUNTIME=$(grep "^MAGENTO_BACKEND_URL=" "${PWA_DIR}/.env" 2>/dev/null | cut -d= -f2- | head -1)
if [[ -n "$BACKEND_URL_RUNTIME" && -f "${MAGENTO_ROOT}/.htaccess" ]]; then
    sed -i '/^SetEnv MAGENTO_BACKEND_URL /d' "${MAGENTO_ROOT}/.htaccess"
    sed -i "1s|^|SetEnv MAGENTO_BACKEND_URL ${BACKEND_URL_RUNTIME}\n\n|" "${MAGENTO_ROOT}/.htaccess"
    echo "[pwa-build] SetEnv MAGENTO_BACKEND_URL written to .htaccess: $BACKEND_URL_RUNTIME"
fi

# ── Done ─────────────────────────────────────────────────────────────────────

echo ""
echo "[pwa-build] Done!"
echo "  PWA (UPWARD-PHP): https://${PROJECT}.${PHP_SEGMENT}.127.0.0.1.nip.io/"
echo "  No Node process needed — served through Magento."
echo ""
echo "  To switch back to Luma:"
echo "    bin/magento config:delete web/upward/path && bin/magento cache:flush"
