#!/bin/bash
# pwa-logs — tail the PWA Studio dev server log
#
# USAGE
#   pwa-logs [project] [options]
#
# OPTIONS
#   -f       Follow (like tail -f)
#   -n N     Lines to show (default: 50)

set -e

APACHE_ROOT="${M2D_APACHE_ROOT_DIRECTORY:-/var/www/html}"
FOLLOW=0
LINES=50
PROJECT=""

usage() {
    sed -n '2,/^set -e/p' "$0" | grep '^#' | sed 's/^# \?//'
    exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
    case $1 in
        -f)        FOLLOW=1;        shift   ;;
        -n)        LINES="$2";      shift 2 ;;
        -h|--help) usage 0 ;;
        -*)        echo "Unknown option: $1"; usage 1 ;;
        *)         PROJECT="$1";    shift   ;;
    esac
done

if [[ -z "$PROJECT" ]]; then
    if [[ "$PWD" == "${APACHE_ROOT}/"* ]]; then
        PROJECT=$(echo "$PWD" | sed "s|^${APACHE_ROOT}/||" | cut -d'/' -f1)
    else
        echo "Error: project name required (or run from inside the project directory)."
        usage 1
    fi
fi

LOG_FILE="/var/log/pwa/${PROJECT}.log"

if [[ ! -f "$LOG_FILE" ]]; then
    echo "[pwa-logs] No log file: ${LOG_FILE}"
    echo "  The dev server has not been started for this project."
    echo "  Run: pwa-start ${PROJECT}"
    exit 1
fi

if [[ $FOLLOW -eq 1 ]]; then
    exec tail -n "$LINES" -f "$LOG_FILE"
else
    exec tail -n "$LINES" "$LOG_FILE"
fi
