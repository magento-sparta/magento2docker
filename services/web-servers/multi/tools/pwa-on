#!/bin/bash
# pwa-on — re-enable UPWARD-PHP using the previously built upward.yml
#
# USAGE
#   pwa-on [project] [options]
#
# OPTIONS
#   --store CODE    Store view code for multi-store setups (e.g. en, fr).
#                   Sets web/upward/path at the store scope instead of default.
#   --php VERSION   Override detected PHP version (e.g. --php 8.3)
#
# DESCRIPTION
#   Reads the built upward.yml from the project meta file, sets
#   web/upward/path config, and flushes cache.
#   No yarn build, no module operations — fast (~5 sec).
#
#   Run pwa-build first if no build exists yet.
#   Project auto-detected when run from inside the project directory.

set -e

source /usr/local/bin/m2d-lib.sh

APACHE_ROOT="${M2D_APACHE_ROOT_DIRECTORY:-/var/www/html}"

usage() {
    sed -n '2,/^set -e/p' "$0" | grep '^#' | sed 's/^# \?//'
    exit "${1:-0}"
}

PROJECT=""
STORE_CODE=""
OVERRIDE_PHP=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --store)    STORE_CODE="$2";   shift 2 ;;
        --php)      OVERRIDE_PHP="$2"; shift 2 ;;
        -h|--help)  usage 0 ;;
        -*)         echo "Unknown option: $1"; usage 1 ;;
        *)          PROJECT="$1"; shift ;;
    esac
done

if [[ -z "$PROJECT" ]]; then
    if [[ "$PWD" == "${APACHE_ROOT}/"* ]]; then
        PROJECT=$(echo "$PWD" | sed "s|^${APACHE_ROOT}/||" | cut -d'/' -f1)
        echo "[pwa-on] detected project: $PROJECT"
    else
        echo "Error: project name required (or run from inside the project directory)."
        usage 1
    fi
fi
pwa_validate_code "project" "$PROJECT"; pwa_validate_code "store" "$STORE_CODE"

MAGENTO_ROOT="${APACHE_ROOT}/${PROJECT}"

# ── Load meta ─────────────────────────────────────────────────────────────────

META_FILE=$(pwa_meta_file "$APACHE_ROOT" "$PROJECT" "$STORE_CODE")
if [[ ! -f "$META_FILE" ]]; then
    echo "[pwa-on] Error: no meta file for '${PROJECT}'${STORE_CODE:+ store '${STORE_CODE}'}."
    echo "  Run: pwa-build ${PROJECT}${STORE_CODE:+ --store ${STORE_CODE}}"
    exit 1
fi

if [[ ! -f "$MAGENTO_ROOT/bin/magento" ]]; then
    echo "[pwa-on] Error: bin/magento not found at $MAGENTO_ROOT"
    exit 1
fi

# ── Resolve upward.yml ────────────────────────────────────────────────────────
# Priority: UPWARD_YML= (set by pwa-build) → UPWARD_YML_SAVED= (set by pwa-off)
# → filesystem search in the PWA directory.

UPWARD_YML=$(grep "^UPWARD_YML=" "$META_FILE" 2>/dev/null | cut -d= -f2- || true)
if [[ -z "$UPWARD_YML" ]]; then
    UPWARD_YML=$(grep "^UPWARD_YML_SAVED=" "$META_FILE" 2>/dev/null | cut -d= -f2- || true)
fi

# Fallback: scan the registered PWA directory
if [[ -z "$UPWARD_YML" ]]; then
    _pwa_dir=$(grep "^PWA_DIR=" "$META_FILE" 2>/dev/null | cut -d= -f2- || true)
    if [[ -n "$_pwa_dir" ]]; then
        if   [[ -f "${_pwa_dir}/upward.yml" ]];      then UPWARD_YML="${_pwa_dir}/upward.yml"
        elif [[ -f "${_pwa_dir}/dist/upward.yml" ]]; then UPWARD_YML="${_pwa_dir}/dist/upward.yml"
        fi
    fi
fi

if [[ -z "$UPWARD_YML" ]]; then
    echo "[pwa-on] Error: no built upward.yml found for '${PROJECT}'${STORE_CODE:+ store '${STORE_CODE}'}."
    echo "  Run: pwa-build ${PROJECT}${STORE_CODE:+ --store ${STORE_CODE}}"
    exit 1
fi

if [[ ! -f "$UPWARD_YML" ]]; then
    echo "[pwa-on] Error: upward.yml not found on disk: $UPWARD_YML"
    echo "  Run: pwa-build ${PROJECT}${STORE_CODE:+ --store ${STORE_CODE}}"
    exit 1
fi

# ── PHP version ───────────────────────────────────────────────────────────────

detect_php "$MAGENTO_ROOT"

if [[ -n "$OVERRIDE_PHP" ]]; then
    _ver="${OVERRIDE_PHP//./}"; _ver="${_ver#php}"
    _candidate="/usr/local/bin/php${_ver}"
    if [[ ! -x "$_candidate" ]]; then
        echo "[pwa-on] Error: PHP binary not found: $_candidate"
        exit 1
    fi
    PHP_BIN="$_candidate"
    PHP_SEGMENT=$("$PHP_BIN" -r 'echo "php".PHP_MAJOR_VERSION.PHP_MINOR_VERSION;')
    PHP_VERSION=$("$PHP_BIN" -r 'echo PHP_MAJOR_VERSION.".".PHP_MINOR_VERSION;')
fi

echo "[pwa-on] project    : $PROJECT${STORE_CODE:+  store: $STORE_CODE}"
echo "[pwa-on] upward.yml : $UPWARD_YML"
echo "[pwa-on] php        : $PHP_BIN ($PHP_VERSION)"

# ── Already on? ───────────────────────────────────────────────────────────────

_current_yml=$(grep "^UPWARD_YML=" "$META_FILE" 2>/dev/null | cut -d= -f2- || true)
if [[ -n "$_current_yml" && ! -f "$META_FILE" ]] || \
   ( [[ -n "$_current_yml" ]] && ! grep -q "^UPWARD_OFF=1" "$META_FILE" 2>/dev/null ); then
    # UPWARD_YML= is set and UPWARD_OFF is not — already on
    echo "[pwa-on] already on — PWA is the active frontend"
    if [[ -n "$STORE_CODE" ]]; then
        echo "  https://${PROJECT}.${PHP_SEGMENT}.127.0.0.1.nip.io/${STORE_CODE}/"
    else
        echo "  https://${PROJECT}.${PHP_SEGMENT}.127.0.0.1.nip.io/"
    fi
    exit 0
fi

# ── config:set web/upward/path ────────────────────────────────────────────────

cd "$MAGENTO_ROOT"
echo ""
echo "[pwa-on] setting web/upward/path..."
if [[ -n "$STORE_CODE" ]]; then
    run_as_magento "$PHP_BIN" bin/magento config:set \
        --scope=stores --scope-code="${STORE_CODE}" \
        web/upward/path "$UPWARD_YML"
else
    run_as_magento "$PHP_BIN" bin/magento config:set web/upward/path "$UPWARD_YML"
fi

# ── cache:flush ───────────────────────────────────────────────────────────────

echo "[pwa-on] cache:flush..."
run_as_magento "$PHP_BIN" bin/magento cache:flush

# ── Update meta ───────────────────────────────────────────────────────────────

sed -i '/^UPWARD_YML=/d'        "$META_FILE"
sed -i '/^UPWARD_OFF=/d'        "$META_FILE"
sed -i '/^UPWARD_YML_SAVED=/d'  "$META_FILE"
echo "UPWARD_YML=${UPWARD_YML}" >> "$META_FILE"

# ── Done ──────────────────────────────────────────────────────────────────────

echo ""
echo "[pwa-on] Done!"
if [[ -n "$STORE_CODE" ]]; then
    echo "  PWA active: https://${PROJECT}.${PHP_SEGMENT}.127.0.0.1.nip.io/${STORE_CODE}/"
else
    echo "  PWA active: https://${PROJECT}.${PHP_SEGMENT}.127.0.0.1.nip.io/"
fi
echo ""
echo "  Switch to Luma: pwa-off ${PROJECT}${STORE_CODE:+ --store ${STORE_CODE}}"
