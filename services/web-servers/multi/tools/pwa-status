#!/bin/bash
# pwa-status — show status of all PWA Studio projects and stores
#
# USAGE
#   pwa-status [project] [--store CODE]
#
# DESCRIPTION
#   For each project with a .pwa (or .pwa.<store>) meta file, shows:
#     - PWA directory and PHP version
#     - Install state: node_modules and dist/upward.yml present?
#     - Dev server state (running / stopped) with URL if running
#     - UPWARD-PHP state (configured / not)
#     - UPWARD connector present?
#
#   Without arguments, shows all projects and all their stores.
#   With a project name, shows all stores for that project.
#   With --store, shows only that specific store.
#
#   Project name is auto-detected when run from inside a project directory.
#
# EXAMPLES
#   pwa-status          # all projects, all stores
#   pwa-status 24dev    # all stores of 24dev
#   pwa-status 24dev --store en   # only the en store

set -e

source /usr/local/bin/m2d-lib.sh

APACHE_ROOT="${M2D_APACHE_ROOT_DIRECTORY:-/var/www/html}"

usage() {
    sed -n '2,/^set -e/p' "$0" | grep '^#' | sed 's/^# \?//'
    exit "${1:-0}"
}

PROJECT=""
FILTER_STORE=""

while [[ $# -gt 0 ]]; do
    case $1 in
        --store)   FILTER_STORE="$2"; shift 2 ;;
        -h|--help) usage 0 ;;
        -*)        echo "Unknown option: $1"; usage 1 ;;
        *)         PROJECT="$1"; shift ;;
    esac
done

# Auto-detect from cwd only when inside a specific project directory
if [[ -z "$PROJECT" && "$PWD" == "${APACHE_ROOT}/"* ]]; then
    _candidate=$(echo "$PWD" | sed "s|^${APACHE_ROOT}/||" | cut -d'/' -f1)
    # Only auto-select if it has any .pwa file (is a configured pwa project)
    _has_pwa=0
    [[ -f "${APACHE_ROOT}/${_candidate}/.pwa" ]] && _has_pwa=1
    if [[ $_has_pwa -eq 0 ]]; then
        for _f in "${APACHE_ROOT}/${_candidate}/.pwa."*; do
            [[ -f "$_f" ]] && { _has_pwa=1; break; }
        done
    fi
    [[ $_has_pwa -eq 1 ]] && PROJECT="$_candidate" || true
fi

# ── Per-store status ──────────────────────────────────────────────────────────

show_status() {
    local project="$1"
    local store="${2:-}"   # empty = default store
    local meta run_key

    meta=$(pwa_meta_file "$APACHE_ROOT" "$project" "$store")
    run_key=$(pwa_run_key "$project" "$store")

    if [[ ! -f "$meta" ]]; then
        echo "[pwa-status] ${run_key}: no meta file (run pwa-install first)"
        return
    fi

    local pwa_dir port pid_file
    pwa_dir=$(grep "^PWA_DIR=" "$meta" | cut -d= -f2-)
    port=$(grep "^PWA_PORT=" "$meta" 2>/dev/null | cut -d= -f2- || true)
    pid_file="/var/run/pwa/${run_key}.pid"

    detect_php "${APACHE_ROOT}/${project}"

    # ── Install / build state ─────────────────────────────────────────────────
    local node_state build_state prebuilt_label=""
    [[ -d "${pwa_dir}/node_modules" ]] && node_state="node_modules ✓" || node_state="node_modules ✗"
    if [[ -f "${pwa_dir}/dist/upward.yml" || -f "${pwa_dir}/upward.yml" ]]; then
        build_state="dist ✓"
    else
        build_state="dist ✗"
    fi
    [[ ! -f "${pwa_dir}/package.json" ]] && prebuilt_label="  [pre-built]"

    # ── Dev server ────────────────────────────────────────────────────────────
    local dev_line dev_url
    dev_url=$(pwa_dev_url "$run_key" "$PHP_SEGMENT")
    if [[ -f "$pid_file" ]]; then
        local pid; pid=$(cat "$pid_file")
        if kill -0 "$pid" 2>/dev/null; then
            dev_line="running   pid=${pid}  port=${port:-?}  ${dev_url}"
        else
            rm -f "$pid_file"
            dev_line="stopped   (stale pid removed)"
        fi
    else
        dev_line="stopped"
    fi

    # ── UPWARD-PHP ────────────────────────────────────────────────────────────
    local upward_line="not configured"
    # Meta file records UPWARD_YML after pwa-build / pwa-wizard / pwa-on.
    # UPWARD_OFF=1 is written by pwa-off; UPWARD_YML_SAVED= preserves the path.
    local _meta_upward _meta_off _meta_saved
    _meta_upward=$(grep "^UPWARD_YML=" "$meta" 2>/dev/null | cut -d= -f2- || true)
    _meta_off=$(grep "^UPWARD_OFF=" "$meta" 2>/dev/null | cut -d= -f2- || true)
    _meta_saved=$(grep "^UPWARD_YML_SAVED=" "$meta" 2>/dev/null | cut -d= -f2- || true)

    if [[ -n "$store" ]]; then
        if [[ -n "$_meta_upward" && -f "$_meta_upward" ]]; then
            upward_line="configured  https://${project}.${PHP_SEGMENT}.127.0.0.1.nip.io/${store}/"
        elif [[ "$_meta_off" == "1" ]]; then
            if [[ -n "$_meta_saved" && -f "$_meta_saved" ]]; then
                upward_line="off  (dist ready — run: pwa-on ${project} --store ${store})"
            else
                upward_line="off"
            fi
        elif [[ -x "${APACHE_ROOT}/${project}/bin/magento" ]]; then
            # Fallback: ask Magento directly (slower, only when meta has no record)
            local _upward_path
            _upward_path=$(run_as_magento "$PHP_BIN" "${APACHE_ROOT}/${project}/bin/magento" \
                config:show --scope=stores --scope-code="${store}" web/upward/path \
                2>/dev/null | tr -d '[:space:]' || true)
            [[ -n "$_upward_path" ]] && \
                upward_line="configured  https://${project}.${PHP_SEGMENT}.127.0.0.1.nip.io/${store}/"
        fi
    else
        if [[ -n "$_meta_upward" && -f "$_meta_upward" ]]; then
            upward_line="configured  https://${project}.${PHP_SEGMENT}.127.0.0.1.nip.io/"
        elif [[ "$_meta_off" == "1" ]]; then
            if [[ -n "$_meta_saved" && -f "$_meta_saved" ]]; then
                upward_line="off  (dist ready — run: pwa-on ${project})"
            else
                upward_line="off"
            fi
        elif grep -q "^SetEnv MAGENTO_BACKEND_URL " "${APACHE_ROOT}/${project}/.htaccess" 2>/dev/null; then
            upward_line="configured  https://${project}.${PHP_SEGMENT}.127.0.0.1.nip.io/"
        fi
    fi

    # ── UPWARD connector ──────────────────────────────────────────────────────
    local connector_line="not found"
    if [[ -d "${APACHE_ROOT}/${project}/vendor/magento/module-upward-connector" ]] ||
       [[ -d "${APACHE_ROOT}/${project}/app/code/Magento/UpwardConnector" ]]; then
        connector_line="present"
    fi

    local store_label=""
    [[ -n "$store" ]] && store_label="  store: ${store}"

    echo "[pwa-status] ${project}${store_label}"
    echo "  dir       : ${pwa_dir}"
    echo "  php       : ${PHP_VERSION} [${PHP_DETECTED_FROM}]"
    echo "  install   : ${node_state}   ${build_state}${prebuilt_label}"
    echo "  dev       : ${dev_line}"
    echo "  upward    : ${upward_line}"
    echo "  connector : ${connector_line}"
}

# ── Per-project: enumerate all stores ────────────────────────────────────────

show_project() {
    local project="$1"
    local pdir="${APACHE_ROOT}/${project}"

    if [[ -n "$FILTER_STORE" ]]; then
        show_status "$project" "$FILTER_STORE"
        return
    fi

    # Default store
    [[ -f "${pdir}/.pwa" ]] && show_status "$project" || true

    # Named stores (.pwa.<store>)
    for meta in "${pdir}/.pwa."*; do
        [[ -f "$meta" ]] || continue
        local store="${meta##*/.pwa.}"
        show_status "$project" "$store"
    done
}

# ── Main ──────────────────────────────────────────────────────────────────────

if [[ -n "$PROJECT" ]]; then
    show_project "$PROJECT"
else
    found=0
    for pdir in "${APACHE_ROOT}"/*/; do
        [[ -d "$pdir" ]] || continue
        project=$(basename "$pdir")
        # Skip if no .pwa files at all
        _has=0
        [[ -f "${pdir}.pwa" ]] && _has=1
        if [[ $_has -eq 0 ]]; then
            for _f in "${pdir}.pwa."*; do
                [[ -f "$_f" ]] && { _has=1; break; }
            done
        fi
        [[ $_has -eq 0 ]] && continue
        show_project "$project"
        found=$((found + 1))
    done
    [[ $found -eq 0 ]] && echo "[pwa-status] no PWA projects configured" || true
fi
